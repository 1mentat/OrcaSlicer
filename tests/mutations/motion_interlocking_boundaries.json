      "old": "config.interlocking_depth < 1",
      "new": "config.interlocking_depth < 2",
      "expected_matches": 1,
      "description": "Treat the registered minimum depth 1 as disabled; the minimum-depth fixture expects both regions to remain nonempty and redistribute the interface.",
      "test_filter": "^InterlockingVariance$",
      "ordinary_assertion_only": true,
      "source_anchor_sha256": "f771a27afa17c5e074b2e404cdf307706aee27937e4da41e47ed41851ebcee44"
    },
    {
      "id": "interlocking-width-minimum-disabled-at-001",
      "path": "src/libslic3r/Feature/Interlocking/InterlockingGenerator.cpp",
      "old": "config.interlocking_beam_width < EPSILON",
      "new": "config.interlocking_beam_width <= 0.01",
      "expected_matches": 1,
      "description": "Treat the registered minimum width 0.01 mm as disabled; the bounded fine-grid fixture requires nonempty regions, conserved total union, and changed material ownership.",
      "test_filter": "^InterlockingVariance$",
      "ordinary_assertion_only": true,
      "source_anchor_sha256": "4a84e4b510b7b6a464ba72a38dbfda5d220f5fac34986c789e47ff0ca9620f33"
