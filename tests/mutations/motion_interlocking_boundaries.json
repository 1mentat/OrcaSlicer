{
  "schema_version": 1,
  "description": "Boundary contracts for initial-layer jerk, zero-auto small-perimeter speed, retraction rounding, and minimum/periodic interlocking geometry. Filters select CTest labels.",
  "mutants": [
    {
      "id": "initial-layer-jerk-wrong-selected-value",
      "path": "src/libslic3r/GCode.cpp",
      "old": "jerk = NOZZLE_CONFIG(initial_layer_jerk);",
      "new": "jerk = NOZZLE_CONFIG(default_jerk);",
      "expected_matches": 1,
      "description": "Use default jerk on first-layer extrusion instead of the configured initial-layer jerk; the selected zero/positive and nullable inheritance cases require 23/14 and 15/17 mm/s respectively.",
      "test_filter": "^(SettingsSpeedAccelVariance|SmallPerimeterSpeed|Wipe)$",
      "ordinary_assertion_only": true,
      "source_anchor_sha256": "431fe3884034d9802467304ad9ecbb0ec91df0e03d0877a97042722aa1260c8c"
    },
    {
      "id": "small-perimeter-zero-auto-half-wall",
      "path": "src/libslic3r/GCode.cpp",
      "old": "small_peri_speed = NOZZLE_CONFIG(outer_wall_speed) * 0.5;",
      "new": "small_peri_speed = NOZZLE_CONFIG(outer_wall_speed) * 1.0;",
      "expected_matches": 1,
      "description": "Resolve zero-auto small perimeter speed to the full outer-wall feed instead of half; the bounded 50 mm/s wall fixture expects 25 mm/s.",
      "test_filter": "^(SettingsSpeedAccelVariance|SmallPerimeterSpeed|Wipe)$",
      "ordinary_assertion_only": true,
      "source_anchor_sha256": "a2c209cffeb573f9902691fd7906ba4bff96b32cd994c2a1f105876fd84384ef"
    },
    {
      "id": "retraction-speed-drop-rounding-offset",
      "path": "src/libslic3r/Extruder.cpp",
      "old": "return int(floor(m_config->retraction_speed.get_at(m_config_index)+0.5));",
      "new": "return int(floor(m_config->retraction_speed.get_at(m_config_index)));",
      "expected_matches": 1,
      "description": "Drop the positive rounding offset when converting retraction speed; the 1.5 mm/s consumer boundary expects F120 rather than F60.",
      "test_filter": "^(SettingsSpeedAccelVariance|SmallPerimeterSpeed|Wipe)$",
      "ordinary_assertion_only": true,
      "source_anchor_sha256": "a1e532a622d9c349d81b5aeb75608086da781f18da4e996feb8a3a04d3e5fecb"
    },
    {
      "id": "interlocking-depth-minimum-disabled-at-1",
