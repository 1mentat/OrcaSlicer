    {
      "id": "interlocking-orientation-360-clamped-to-359",
      "path": "src/libslic3r/Feature/Interlocking/InterlockingGenerator.cpp",
      "old": "const float    rotation           = Geometry::deg2rad(config.interlocking_orientation.value);",
      "new": "const float    rotation           = Geometry::deg2rad(std::min(config.interlocking_orientation.value, 359.0));",
      "expected_matches": 1,
      "description": "Clamp the 360-degree endpoint to 359 degrees; the 0/360 periodicity and per-region ownership assertions should fail ordinarily.",
      "test_filter": "^InterlockingVariance$",
      "ordinary_assertion_only": true,
      "source_anchor_sha256": "301a48206df8b0444cc2ab6fe064847fff56300906409c4c020f9bda59abde6b"
