      "expected_matches": 1,
      "test_filter": "^LayerProfileEditing$",
      "ordinary_assertion_only": true,
      "description": "Both above- and below-nominal rows must approach the nominal thickness without crossing it."
    },
    {
      "id": "layer-profile-smoothing-disabled",
      "path": "src/libslic3r/Slicing.cpp",
      "old": "if (action == LAYER_HEIGHT_EDIT_ACTION_SMOOTH) {",
      "new": "if (false) {",
      "expected_matches": 1,
      "test_filter": "^LayerProfileEditing$",
      "ordinary_assertion_only": true,
      "description": "Resampling alone preserves the sharp peak; smoothing must lower it while retaining distant samples."
    }
  ]
}
