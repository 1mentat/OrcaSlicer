      "new": "layer_thickness_delta = layer_thickness_delta;",
      "expected_matches": 1,
      "test_filter": "^LayerProfileEditing$",
      "ordinary_assertion_only": true,
      "description": "Decrease must reach the minimum thickness, not the maximum."
